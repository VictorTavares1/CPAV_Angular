# ====================================================================
# .htaccess para o site CPAV em Apache (Amen / hosting partilhado)
# ====================================================================

# 1. Forçar HTTPS (recomendado para segurança)
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Redireciona http -> https automaticamente
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # 2. Não tocar nos pedidos para a API PHP
    RewriteRule ^CPAV_api/ - [L]

    # 3. Não tocar nos pedidos para uploads (imagens, PDFs)
    RewriteRule ^uploads/ - [L]

    # 4. Para tudo o resto: se o ficheiro/pasta NÃO existir, devolve o index.html
    # Isto é o que faz as rotas Angular (/admin, /noticias, etc.) funcionarem
    # quando alguém atualiza a página ou cola um URL direto.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.html [L]
</IfModule>

# 5. Compressão (acelera o carregamento dos JS/CSS)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# 6. Cache de assets estáticos (browser guarda 1 ano para hashed files)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 year"
    # O index.html nunca deve ser cacheado, para que novas versões cheguem aos visitantes
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# 7. Esconder a versão do servidor das respostas (segurança)
ServerSignature Off
